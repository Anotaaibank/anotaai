# Banco local próprio para desenvolvimento. Em produção configure Supabase.
ANOTA_STORAGE=local
ANOTA_DATABASE_PATH=.data/anota-ai.sqlite
# IDs de usuários que podem abrir /gestao. Apenas no servidor; nunca NEXT_PUBLIC_.
ANOTA_MANAGER_USER_IDS=
# Domínio HTTPS para divulgação. Localhost gera somente links de teste.
ANOTA_PUBLIC_URL=
# Serviço ainda não conectado: asaas, stripe ou mercadopago.
ANOTA_BILLING_PROVIDER=
# Chave própria do Anotei para assinar cookies de campanha em produção.
ANOTA_CAMPAIGN_SIGNING_KEY=
APP_URL=http://localhost:3100
# Produção: ANOTA_STORAGE=supabase e um projeto NOVO, com schema.sql aplicado.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# IA e WhatsApp: nunca usar NEXT_PUBLIC_ para essas chaves.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
ANOTA_ASSISTANT_ENABLED=true
ANOTA_WHATSAPP_URL=
# Receptor HTTPS separado para testes locais; APP_URL permanece localhost.
ANOTA_WHATSAPP_WEBHOOK_URL=
ANOTA_WHATSAPP_ADMIN_TOKEN=
ANOTA_WHATSAPP_ENCRYPTION_KEY=
ANOTA_WORKER_SECRET=
# Opcional: endereço interno do servidor para o worker em containers.
ANOTA_WORKER_URL=
# Portal de convites: origem HTTPS e aplicação compilada local opcional.
ANOTA_PERSONAL_UPSTREAM=
ANOTA_PERSONAL_BUILD=
ANOTA_PERSONAL_PORT=3103
# Assinantes precisam de liberação válida; a gestão configurada é isenta.
ANOTA_REQUIRE_SUBSCRIPTION=0
# Base nativa: desligada até autorização de habilitação no servidor.
# ANOTA_MOBILE_API_ENABLED=0
# ANOTA_MOBILE_SESSION_KEY=gerar-no-servidor-minimo-32-caracteres
