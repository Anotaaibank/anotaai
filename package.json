{
  "name": "anota-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "integrations:check": "node scripts/check-integrations.mjs",
    "deployment:check": "node scripts/deployment-preflight.mjs",
    "whatsapp:worker": "node scripts/whatsapp-worker.mjs",
    "whatsapp:bridge": "node --experimental-strip-types scripts/whatsapp-webhook-bridge.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
